{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "44rem", "wideSize": "72rem" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "ink", "color": "#16263D", "name": "Ink" },
				{ "slug": "wheat", "color": "#E6B546", "name": "Wheat" },
				{ "slug": "sky", "color": "#D4E6EE", "name": "Chinook sky" },
				{ "slug": "paper", "color": "#FFFFFF", "name": "Paper" },
				{ "slug": "slate", "color": "#2C3440", "name": "Slate" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{ "slug": "display", "name": "Bricolage Grotesque", "fontFamily": "\"Bricolage Grotesque\", \"Helvetica Neue\", Arial, sans-serif" },
				{ "slug": "body", "name": "Source Sans 3", "fontFamily": "\"Source Sans 3\", \"Segoe UI\", Roboto, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9375rem", "name": "Small" },
				{ "slug": "medium", "size": "1.125rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(2rem, 3vw + 1rem, 3rem)", "name": "Extra large" }
			]
		},
		"spacing": { "units": [ "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--slate)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.6" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "lineHeight": "1.1" }, "color": { "text": "var(--wp--preset--color--ink)" } },
			"link": { "color": { "text": "var(--wp--preset--color--ink)" } }
		}
	}
}
