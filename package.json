{
	"name": "northfield-theme",
	"version": "1.0.0",
	"private": true,
	"description": "Custom WordPress theme with React Gutenberg blocks, ACF, and SCSS.",
	"author": "Kate (Utsanakorn) Chinkanglor",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks --webpack-copy-php",
		"build:css": "sass src/scss/main.scss assets/css/main.css --style=compressed --no-source-map",
		"build": "npm run build:blocks && npm run build:css",
		"start:blocks": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks --webpack-copy-php",
		"watch:css": "sass --watch src/scss/main.scss assets/css/main.css",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"format": "wp-scripts format src"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0",
		"sass": "^1.77.0",
		"typescript": "5.6"
	}
}
